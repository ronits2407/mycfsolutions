#include <bits/stdc++.h>
using namespace std;
#define int long long
 
void solve()
{
    int a, b, c;
    cin >> a >> b >> c;
 
    if (a > b)
    {
        swap(a, b);
    }
 
    int right_middle =  b - a - 1;
    if (right_middle < a - 1)
    {
        cout << -1 << endl;
        return;
    }
 
    int total = b + (right_middle - (a - 1));
    if (total % 2 == 1 || c > total)
    {
        cout << -1 << endl;
        return;
    }
 
    cout << (((c - 1) + total / 2) % total) + 1 << endl;
   
}
 
int32_t main()
{
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(NULL);
    
    int t;
    cin >> t;
    
    while(t--)
    {
        solve();
    }
 
    return 0;
}